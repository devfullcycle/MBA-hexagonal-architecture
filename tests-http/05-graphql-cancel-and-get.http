@baseUrl = http://localhost:8080

### Create partner (setup, so this file can run on its own)
< {%
    const n = (Date.now() + 1).toString().padStart(14, "0").slice(-14);
    request.variables.set("cnpj", n.slice(0,2) + "." + n.slice(2,5) + "." + n.slice(5,8) + "/" + n.slice(8,12) + "-" + n.slice(12,14));
    request.variables.set("partnerEmail", "disney" + Date.now() + "@gmail.com");
%}
POST {{baseUrl}}/graphql
Content-Type: application/json

{
  "query": "mutation($input: PartnerInput) { createPartner(input: $input) { id name email cnpj } }",
  "variables": {
    "input": {
      "name": "Disney",
      "email": "{{partnerEmail}}",
      "cnpj": "{{cnpj}}"
    }
  }
}

> {%
    client.test("partner created", function() {
        client.assert(response.status === 200, "status is not 200");
    });
    client.global.set("graphqlPartnerId", response.body.data.createPartner.id);
%}

### Create event (setup, via GraphQL too)
POST {{baseUrl}}/graphql
Content-Type: application/json

{
  "query": "mutation($input: EventInput) { createEvent(input: $input) { id name date totalSpots status } }",
  "variables": {
    "input": {
      "name": "Disney on Ice",
      "date": "2026-12-01",
      "totalSpots": 10,
      "partnerId": "{{graphqlPartnerId}}"
    }
  }
}

> {%
    client.test("event created", function() {
        client.assert(response.status === 200, "status is not 200");
        client.assert(response.body.data.createEvent.status === null, "a freshly created event should not carry a status yet");
    });
    client.global.set("graphqlEventId", response.body.data.createEvent.id);
%}

### Get event before cancelling (should be ACTIVE)
POST {{baseUrl}}/graphql
Content-Type: application/json

{
  "query": "query($id: ID!) { eventOfId(id: $id) { id name status } }",
  "variables": { "id": "{{graphqlEventId}}" }
}

> {%
    client.test("event is ACTIVE before cancelling", function() {
        client.assert(response.status === 200, "status is not 200");
        client.assert(response.body.data.eventOfId.status === "ACTIVE", "status is not ACTIVE");
    });
%}

### Cancel event (GraphQL mutation)
POST {{baseUrl}}/graphql
Content-Type: application/json

{
  "query": "mutation($id: ID!) { cancelEvent(id: $id) { id status } }",
  "variables": { "id": "{{graphqlEventId}}" }
}

> {%
    client.test("event cancelled via graphql", function() {
        client.assert(response.status === 200, "status is not 200");
        client.assert(response.body.data.cancelEvent.status === "CANCELLED", "status is not CANCELLED");
    });
%}

### Get event after cancelling (should be CANCELLED)
POST {{baseUrl}}/graphql
Content-Type: application/json

{
  "query": "query($id: ID!) { eventOfId(id: $id) { id name status } }",
  "variables": { "id": "{{graphqlEventId}}" }
}

> {%
    client.test("event is CANCELLED after cancelling", function() {
        client.assert(response.status === 200, "status is not 200");
        client.assert(response.body.data.eventOfId.status === "CANCELLED", "status is not CANCELLED");
    });
%}

### Cancel event again (should fail: already cancelled)
POST {{baseUrl}}/graphql
Content-Type: application/json

{
  "query": "mutation($id: ID!) { cancelEvent(id: $id) { id status } }",
  "variables": { "id": "{{graphqlEventId}}" }
}

> {%
    client.test("cancelling twice via graphql returns a graphql error", function() {
        client.assert(response.status === 200, "status is not 200");
        client.assert(response.body.errors != null, "expected a graphql error for an already cancelled event");
    });
%}
