@baseUrl = http://localhost:8080

### Create partner
< {%
    const n = (Date.now() + 1).toString().padStart(14, "0").slice(-14);
    request.variables.set("cnpj", n.slice(0,2) + "." + n.slice(2,5) + "." + n.slice(5,8) + "/" + n.slice(8,12) + "-" + n.slice(12,14));
    request.variables.set("partnerEmail", "disney" + Date.now() + "@gmail.com");
%}
POST {{baseUrl}}/graphql
Content-Type: application/json

{
  "query": "mutation($input: PartnerInput) { createPartner(input: $input) { id name email cnpj } }",
  "variables": {
    "input": {
      "name": "Disney",
      "email": "{{partnerEmail}}",
      "cnpj": "{{cnpj}}"
    }
  }
}

> {%
    client.test("partner created", function() {
        client.assert(response.status === 200, "status is not 200");
        client.assert(response.body.data.createPartner.id != null, "missing partner id");
    });
    client.global.set("partnerId", response.body.data.createPartner.id);
%}

### Create event
POST {{baseUrl}}/events
Content-Type: application/json

{
  "name": "Disney on Ice",
  "date": "2026-12-01",
  "totalSpots": 10,
  "partnerId": "{{partnerId}}"
}

> {%
    client.test("event created", function() {
        client.assert(response.status === 201, "status is not 201");
        client.assert(response.body.id != null, "missing event id");
    });
    client.global.set("eventId", response.body.id);
%}
